---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/titillium-web/400.css';
import '@fontsource/titillium-web/600.css';
import 'flag-icons/css/flag-icons.min.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Hub da comunidade Pato Racing: eventos, campeonatos e GPs de simuladores de corrida.' } = Astro.props;

const nav = [
  { href: '/', label: 'Início' },
  { href: '/campeonatos', label: 'Campeonatos' },
  { href: '/circuitos', label: 'Circuitos' },
  { href: '/eventos', label: 'Eventos' },
  { href: '/sobre', label: 'Sobre' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Pato Racing Hub</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="pr-header">
      <div class="pr-container pr-header__inner">
        <a href={import.meta.env.BASE_URL} class="pr-header__brand">🦆 PATO RACING</a>
        <nav class="pr-header__nav">
          {nav.map((item) => (
            <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, '')}`}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pr-footer">
      <div class="pr-container">
        <p>Pato Racing — comunidade de simuladores de corrida. Site mantido no GitHub.</p>
      </div>
    </footer>

    <style>
      .pr-header {
        background: var(--pr-bg-elevated);
        border-bottom: 1px solid var(--pr-border);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .pr-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--pr-space-md);
        padding-block: var(--pr-space-md);
        flex-wrap: wrap;
      }

      .pr-header__brand {
        font-family: var(--pr-font-display);
        font-weight: 700;
        font-size: 1.4rem;
        letter-spacing: 0.03em;
        color: var(--pr-text);
      }

      .pr-header__brand:hover {
        text-decoration: none;
        color: var(--pr-red);
      }

      .pr-header__nav {
        display: flex;
        gap: var(--pr-space-lg);
        flex-wrap: wrap;
      }

      .pr-header__nav a {
        font-family: var(--pr-font-display);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.9rem;
        color: var(--pr-text-muted);
      }

      .pr-header__nav a:hover {
        color: var(--pr-red);
        text-decoration: none;
      }

      .pr-footer {
        border-top: 1px solid var(--pr-border);
        margin-top: var(--pr-space-2xl);
        padding-block: var(--pr-space-xl);
        color: var(--pr-text-dim);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
