---
import { getCircuitCapa, getCircuitTracado } from '../lib/circuitImages';

interface Props {
  circuitoId: string;
  nome: string;
  paisCodigo: string;
  kind?: 'capa' | 'tracado';
  alt?: string;
}

const { circuitoId, nome, paisCodigo, kind = 'capa', alt } = Astro.props;
const src = kind === 'capa' ? getCircuitCapa(circuitoId) : getCircuitTracado(circuitoId);
const base = import.meta.env.BASE_URL;
---

{src ? (
  <img class="pr-circuit-image" src={`${base}${src}`} alt={alt ?? nome} loading="lazy" />
) : (
  <div class="pr-circuit-placeholder" role="img" aria-label={alt ?? nome}>
    <span class={`fi fi-${paisCodigo.toLowerCase()} pr-circuit-placeholder__flag`}></span>
    <span class="pr-circuit-placeholder__name">{nome}</span>
  </div>
)}

<style>
  .pr-circuit-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pr-circuit-placeholder {
    width: 100%;
    height: 100%;
    min-height: 160px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--pr-space-sm);
    background: linear-gradient(160deg, var(--pr-surface), var(--pr-bg-elevated));
    color: var(--pr-text-muted);
  }

  .pr-circuit-placeholder__flag {
    font-size: 2.5rem;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--pr-border);
  }

  .pr-circuit-placeholder__name {
    font-family: var(--pr-font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
    text-align: center;
    padding: 0 var(--pr-space-sm);
  }
</style>
